{
  "name": "flappy-poop",
  "version": "0.8.1",
  "description": "A poop emoji flaps through the gut dodging pink intestinal folds. Flappy Bird clone for phone browsers, built on Phaser 4.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test --test-timeout=60000 \"tests/**/*.test.js\"",
    "start": "python3 tools/serve.py",
    "push": "node tools/push.mjs",
    "smoke": "node tools/headless_check.mjs",
    "schema:check": "node tools/schema_check.mjs",
    "schema:stamp": "node tools/schema_check.mjs --stamp"
  },
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12"
  }
}
